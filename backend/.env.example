APP_NAME=CodeGraph
APP_VERSION=1.0.0-rc.1
HOST=127.0.0.1
PORT=8000

# Set true for local debugging
EXPOSE_ERROR_DETAILS=true

# Storage paths (local development)
UPLOAD_DIR=uploads
STORAGE_DIR=storage
CODEGRAPH_DB_PATH=storage/codegraph.db
VECTOR_STORAGE_PATH=storage/vectors

# Optional LLM providers (leave empty to use Copilot local heuristic / mocks)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
