APP_NAME=CodeGraph
APP_VERSION=1.0.0-rc.1
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Set true only in local debugging — never in production
EXPOSE_ERROR_DETAILS=false

# Frontend URL for CORS (production only)
# FRONTEND_URL=https://your-frontend.vercel.app

# Storage paths (for Railway/cloud deployment)
# UPLOAD_DIR=uploads
# STORAGE_DIR=storage
# CODEGRAPH_DB_PATH=/data/codegraph.db
# VECTOR_STORAGE_PATH=/data/vectors

# Optional LLM providers (leave empty to use Copilot local heuristic / mocks)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
