# Application identity
APP_NAME=CodeGraph
APP_VERSION=1.0.0-rc.1

# Server binding
HOST=127.0.0.1
PORT=8000

# Error handling (set true for local debugging, false in production)
EXPOSE_ERROR_DETAILS=true

# Storage paths (local filesystem - all paths relative to backend directory)
UPLOAD_DIR=uploads
STORAGE_DIR=storage
CODEGRAPH_DB_PATH=storage/codegraph.db
VECTOR_STORAGE_PATH=storage/vectors

# Optional LLM providers (leave empty to use Copilot local heuristic / mocks)
# At least one provider key is required for AI-powered features
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
