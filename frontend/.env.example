# Frontend environment

# Local Vite proxy target path. Keep /api so requests go through vite.config.ts proxy
# to http://127.0.0.1:8000 (backend has no CORS middleware).
VITE_API_URL=/api

# Production: point directly at Railway backend URL
# Set this in Vercel environment variables as VITE_API_URL
VITE_API_URL=https://codegraph-production-d523.up.railway.app
